rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidUser(data) {
      return data.uid == request.auth.uid
        && data.uid is string && data.uid.size() <= 128
        && (!('email' in data) || (data.email is string && data.email.size() <= 256))
        && (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 128))
        && (!('phoneNumber' in data) || (data.phoneNumber is string && data.phoneNumber.size() <= 64));
    }

    function isValidProgress(data) {
      return data.userId == request.auth.uid
        && data.userId is string && data.userId.size() <= 128
        && data.currentDay is int && data.currentDay >= 1 && data.currentDay <= 28
        && data.totalScore is int && data.totalScore >= 0
        && data.streakDays is int && data.streakDays >= 0
        && (!('academyName' in data) || (data.academyName is string && data.academyName.size() <= 128));
    }

    // User Profile: Strict owner access only (PII isolation)
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false; // Blanket user listing forbidden
      allow create: if isOwner(userId) && isValidId(userId) && isValidUser(incoming());
      allow update: if isOwner(userId) && isValidId(userId) && isValidUser(incoming()) && incoming().uid == existing().uid;
      allow delete: if isOwner(userId);

      // User Personal Progress Subcollection
      match /progress/{progressDoc} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(userId) && isValidProgress(incoming());
        allow update: if isOwner(userId) && isValidId(userId) && isValidProgress(incoming()) && incoming().userId == existing().userId;
        allow delete: if isOwner(userId);
      }
    }
  }
}
